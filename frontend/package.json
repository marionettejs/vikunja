{
  "name": "vikunja-frontend",
  "description": "The todo app to organize your life.",
  "private": true,
  "version": "2.6.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://code.vikunja.io/vikunja"
  },
  "bugs": {
    "url": "https://code.vikunja.io/vikunja/issues"
  },
  "homepage": "https://vikunja.io/",
  "funding": "https://opencollective.com/vikunja",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "todo",
    "productivity",
    "task management",
    "organisation",
    "gantt",
    "kanban"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "pnpm run dev",
    "preview": "vite preview --port 4173",
    "preview:dev": "vite preview --outDir dist-dev --mode development --port 4173",
    "preview:vikunja": "../vikunja",
    "build": "vite build && workbox copyLibraries dist/",
    "build:dev": "vite build --mode development --outDir dist-dev/",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "pnpm run lint --fix",
    "lint:styles": "stylelint 'src/**/*.{css,scss}'",
    "lint:styles:fix": "pnpm run lint:styles --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui-host=0.0.0.0",
    "test:unit": "vitest --dir ./src",
    "typecheck": "tsc --build --force",
    "fonts:update": "pnpm fonts:download && pnpm fonts:subset",
    "fonts:download": "./scripts/fonts-download.sh",
    "fonts:subset": "./scripts/fonts-subset.sh",
    "generate:api-client": "openapi-ts"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@intlify/core-base": "11.4.10",
    "@mnjs/adapters": "5.0.0-rc.2",
    "@mnjs/data": "5.0.0-rc.2",
    "@mnjs/radio": "5.0.0-rc.2",
    "@mnjs/utils": "5.0.0-rc.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "axios": "1.20.0",
    "blurhash": "2.0.5",
    "bulma-css-variables": "0.9.33",
    "change-case": "5.4.4",
    "cropperjs": "1.6.2",
    "dayjs": "1.11.23",
    "dompurify": "3.4.15",
    "emoji-picker-element": "1.29.1",
    "fast-deep-equal": "3.1.3",
    "flatpickr": "4.6.13",
    "is-touch-device": "1.0.1",
    "klona": "2.0.6",
    "lit-html": "3.3.3",
    "lowlight": "3.3.0",
    "marionette": "5.0.0-rc.2",
    "marked": "18.0.11",
    "nanoid": "6.0.1",
    "register-service-worker": "1.7.2",
    "sortablejs": "1.15.7",
    "ufo": "1.6.4",
    "workbox-precaching": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/codemirror": "5.60.18",
    "@types/is-touch-device": "1.0.3",
    "@types/node": "24.13.3",
    "@types/sortablejs": "1.15.9",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "autoprefixer": "10.5.5",
    "browserslist": "4.28.9",
    "caniuse-lite": "1.0.30001810",
    "csstype": "3.2.3",
    "eslint": "10.10.0",
    "eslint-plugin-depend": "1.5.0",
    "happy-dom": "20.14.0",
    "otplib": "13.5.0",
    "postcss": "8.5.28",
    "postcss-easing-gradients": "3.0.1",
    "postcss-html": "1.8.1",
    "postcss-preset-env": "11.5.1",
    "rollup": "catalog:",
    "rollup-plugin-visualizer": "7.1.1",
    "sass-embedded": "1.104.0",
    "stylelint": "17.15.0",
    "stylelint-config-property-sort-order-smacss": "11.2.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-use-logical": "2.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unplugin-inject-preload": "3.0.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wait-on": "9.1.0",
    "workbox-cli": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "ws": "8.21.3"
  }
}
